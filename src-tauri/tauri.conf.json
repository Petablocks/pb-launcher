{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PETABLOCKS Launcher",
  "version": "1.15.0",
  "identifier": "com.petablocks.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PETABLOCKS Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "PETABLOCKS Launcher",
        "url": "index.html?window=splash",
        "width": 440,
        "height": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https://crafthead.net https://*.petablocks.com https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.petablocks.com https://api.github.com https://raw.githubusercontent.com; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/PETABLOCKS Launcher/instances/*/screenshots/*",
          "$DATA/PETABLOCKS Launcher/instances/*/screenshots/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PETABLOCKS",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}
